# Simple Full-Screen Quad for Post-Processing
# Vertices (x, y, z)
v -1.0  1.0 0.0
v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0

# Texture Coordinates (u, v)
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0

# Normals (pointing straight forward)
vn 0.0 0.0 1.0

# Faces (Vertex/Texture/Normal)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1